#!/usr/bin/env bash
set -euo pipefail

# FlagPilot end-to-end demo script.
# Every write to Flagsmith pauses for interactive human APPROVE input.

FLAGPILOT_BIN="${FLAGPILOT_BIN:-flagpilot}"
if [[ -x ".venv/bin/flagpilot" ]]; then
  FLAGPILOT_BIN=".venv/bin/flagpilot"
elif [[ -x ".venv/Scripts/flagpilot.exe" ]]; then
  FLAGPILOT_BIN=".venv/Scripts/flagpilot.exe"
fi

echo "=== [1/5] PLAN (offline, no Flagsmith calls) ==="
"$FLAGPILOT_BIN" plan "roll out checkout_v2 to 10% in Development, pause if errors exceed 2%"

echo ""
echo "=== [2/5] APPLY (HUMAN ACTION: type APPROVE when prompted) ==="
"$FLAGPILOT_BIN" apply plan.json

echo ""
echo "=== [3/5] RUN WITH SEEDED ERROR SPIKE AT 50% (HUMAN ACTION: type APPROVE at each step & rollback) ==="
# Expects exit code 1 when spike triggers auto-rollback at 50% -> 10%.
set +e
"$FLAGPILOT_BIN" run \
  --feature checkout_v2 \
  --env Development \
  --stages 1 10 50 100 \
  --max-error-rate 0.02 \
  --baseline-error-rate 0.005 \
  --spike-rate 0.25 \
  --spike-threshold-pct 25 \
  --seed 42 \
  --interval 0
RUN_EXIT=$?
set -e
echo "Run exited with code $RUN_EXIT"

echo ""
echo "=== [4/5] ROLLBACK TO 0% (HUMAN ACTION: type APPROVE when prompted) ==="
"$FLAGPILOT_BIN" rollback \
  --feature checkout_v2 \
  --env Development \
  --old-percentage 10 \
  --reason "demo cleanup"

echo ""
echo "=== [5/5] REPORT (static reports/rollout.html from audit.log + reports/last_run.json) ==="
"$FLAGPILOT_BIN" report \
  --input reports/last_run.json \
  --audit-log audit.log \
  --out reports/rollout.html

echo "Demo complete. Open reports/rollout.html in a browser."

