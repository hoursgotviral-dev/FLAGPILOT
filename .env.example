# FlagPilot local environment configuration template.
# Copy to .env (gitignored) and fill in values for your self-hosted Flagsmith instance.
# Note: planner.py and controller.py do not read environment variables.

# Base URL for self-hosted Flagsmith API (used by fsapi.py and simulator.py)
FLAGSMITH_API_URL=http://localhost:8000/api/v1

# Management REST API key / Organisation API Token (required by fsapi.py)
FLAGSMITH_ADMIN_KEY=replace-with-your-flagsmith-admin-key

# Server-side SDK Environment Key (used by simulator.py; also fallback for fsapi.py)
FLAGSMITH_SERVER_KEY=ser.replace-with-your-server-key

# Client-side SDK Environment Key (optional fallback if FLAGSMITH_SERVER_KEY is unset)
FLAGSMITH_CLIENT_KEY=replace-with-your-client-key

# Optional explicit Environment API key override for fsapi.py
# Defaults to FLAGSMITH_SERVER_KEY or FLAGSMITH_CLIENT_KEY when unset
FLAGSMITH_ENVIRONMENT_KEY=

# Optional numeric Flagsmith Project ID for fsapi.py
# Leave blank to auto-resolve the first accessible project via GET /api/v1/projects/
FLAGSMITH_PROJECT_ID=

# Optional demo feature and rollout segment IDs populated by flagpilot.bootstrap
FLAGSMITH_FEATURE_ID=
FLAGSMITH_SEGMENT_ID=

# Optional Grafana Feature Health webhook URL populated by flagpilot.bootstrap
FLAGSMITH_HEALTH_WEBHOOK_URL=

# Optional LLM planner adapter (off by default; zero-key deterministic parser stays default)
# Set FLAGPILOT_LLM_PROVIDER=gemini|openai plus its API key, or pass --use-llm to `flagpilot plan`
FLAGPILOT_LLM_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
FLAGPILOT_LLM_MODEL=
